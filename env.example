# Copy to .env and set at least OPENAI_API_KEY and the two DASHBOARD_* values.

# OpenAI
OPENAI_API_KEY=MY_API_KEY_WITHOUT_QUOTES
OPENAI_DEFAULT_MODEL=gpt-4o
# Backend assigned to new projects: openai or azure
OPENAI_BACKEND=openai

# Dashboard admin login: the username must be an email address
DASHBOARD_USERNAME_ADMIN=admin@example.com
DASHBOARD_PASSWORD_ADMIN=change_me

# Public URLs, built into the production frontend and dashboard (prod profile only).
# On a server, set them to the addresses participants and researchers open,
# e.g. https://chat.example.com and https://api.example.com
CHAT_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# Azure OpenAI (only needed when OPENAI_BACKEND=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=

# Object storage (only needed for participant image uploads)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_BUCKET_NAME=
S3_SECRET_KEY=
S3_REGION_NAME=

# Together.ai (only needed for Llama / DeepSeek models)
TOGETHER_AI_URL=
TOGETHER_AI_KEY=

# Origins of the chat frontend and dashboard allowed to call the backend (comma-separated).
# Default * allows all, e.g. CORS_ALLOWED_ORIGINS=https://chat.example.com,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=*

# Use the first X-Forwarded-For address for per-IP rate limits.
# Only set to true behind a reverse proxy that sets this header.
TRUST_X_FORWARDED_FOR=false

# Sentry: SENTRY_DSN is the backend project, FRONTEND_SENTRY_DSN the chat frontend project
SENTRY_ENABLED=false
SENTRY_DSN=
FRONTEND_SENTRY_DSN=

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
