# Minimal setup: set OPENAI_API_KEY and the three DASHBOARD_* values below.

# OpenAI
OPENAI_API_KEY=MY_API_KEY_WITHOUT_QUOTES
OPENAI_DEFAULT_MODEL=gpt-4o
# Backend assigned to new projects: openai or azure
OPENAI_BACKEND=openai

# Azure OpenAI (only needed when OPENAI_BACKEND=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
# Use "v1" for GPT-5 models (e.g. gpt-5.5); dated versions such as 2024-02-01 also work for older models
AZURE_OPENAI_API_VERSION=2024-02-01
# Optional JSON map from model name to Azure deployment name, if they differ
# AZURE_OPENAI_DEPLOYMENTS={"gpt-5.1-2025-11-13": "my-gpt-51-deployment"}

# Optional: reasoning_effort for GPT-5 models (none, low, medium, high, xhigh); unset = model default
# OPENAI_REASONING_EFFORT=

# Object storage (only needed for participant image uploads)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_BUCKET_NAME=
S3_SECRET_KEY=
S3_REGION_NAME=

# Together.ai (only needed for Llama / DeepSeek models)
TOGETHER_AI_URL=
TOGETHER_AI_KEY=
# Optional: reasoning_effort for Together models; "none" turns thinking off for hybrid models
# TOGETHER_AI_REASONING_EFFORT=none

DATABASE_NAME=chatbot
MONGO_URL=mongodb://db:27017

# Origins of the chat frontend and dashboard allowed to call the backend (comma-separated).
# Default * allows all, e.g. CORS_ALLOWED_ORIGINS=https://chat.example.com,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=*

# Use the first X-Forwarded-For address for per-IP rate limits.
# Only set to true behind a proxy (e.g. Kubernetes ingress) that sets this header.
TRUST_X_FORWARDED_FOR=false

SENTRY_ENABLED=false
SENTRY_DSN=

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Dashboard admin login: the username must be an email address
DASHBOARD_USERNAME_ADMIN=admin@example.com
DASHBOARD_PASSWORD_ADMIN=change-me
# Signs dashboard login tokens: a random value of at least 32 characters,
# e.g. from `openssl rand -hex 32`. Changing it signs everyone out.
DASHBOARD_TOKEN_SECRET=change-me-to-a-random-value-of-32-or-more-characters
